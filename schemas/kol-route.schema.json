{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/kol-route.schema.json",
  "title": "Kol IVR route",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "line", "goal", "target", "version", "status", "steps", "fingerprint", "lastVerifiedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "line": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$" },
    "goal": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["fresh", "stale", "repairing", "unproven"] },
    "fingerprint": { "type": "string", "minLength": 1 },
    "lastVerifiedAt": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "prompt", "action"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "prompt": { "type": "string" },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["dtmf", "speech", "wait", "none"] },
              "value": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
