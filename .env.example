# Copy to .env and fill in. .env is gitignored and never ships.

# From https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# Default is correct; override only for testing against a fake server.
CALLE_BASE_URL=https://api.heycall-e.com

# live   = place real calls (costs money, records every response to artifacts/)
# replay = replay recorded artifacts, zero calls, zero credentials  <-- default
KOL_MODE=replay

# Where recorded call artifacts live. Committed, so judges can replay without a key.
KOL_ARTIFACTS=./artifacts

# The fixture IVR to dial during development. Never a real business.
# E.164, e.g. +1XXXXXXXXXX (a Twilio number we own).
KOL_FIXTURE_LINE=

# A number you control, for the reachability probe.
KOL_SELF_LINE=

# From https://console.twilio.com (Account Info panel). Never paste these in chat.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# CALL-E official US test hotline, published for hackathon testing.
KOL_CALLE_TEST_LINE=+12763229632
